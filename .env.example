# ============================================================================
# Kebo Trade - Környezeti Változók
# ============================================================================
# Másold .env néven és töltsd ki a saját értékeiddel!
# cp .env.example .env
# ============================================================================

# ============================================================================
# MONGODB (KÖTELEZŐ)
# ============================================================================

# Connection string - KÖTELEZŐ!
# Formátum: mongodb://user:password@host:port/database?authSource=admin
# Speciális karakterek URL encode-olva (pl. + → %2B, @ → %40)
MONGODB_URI=mongodb://user:password@host:27017/nautilus?authSource=admin

# MongoDB engedélyezése (default: true)
# Backtest-nél kikapcsolható: MONGODB_ENABLED=false
MONGODB_ENABLED=true

# ============================================================================
# BINANCE API (KÖTELEZŐ live tradinghez)
# ============================================================================

# API kulcsok - https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Testnet mód (default: true)
# true = testnet (teszt pénz)
# false = ÉLES KERESKEDÉS (VALÓS PÉNZ!)
BINANCE_TESTNET=true

# ============================================================================
# STRATÉGIA
# ============================================================================

# Stratégia azonosító (egyedi név)
# Ha több stratégiát futtatsz, mindegyiknek különböző ID kell!
STRATEGY_ID=bounce_scalper_live_001

# ============================================================================
# WEBHOOK (OPCIONÁLIS)
# ============================================================================

# Backend notification URL
# Ha be van állítva, minden DB írás után HTTP POST megy ide
# Példa: http://localhost:3000/api/trading/webhook
WEBHOOK_URL=

# ============================================================================
# LOGGING
# ============================================================================

# Log szint: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
