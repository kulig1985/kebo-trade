# =============================================================================
# Kebo Trade - Környezeti Változók
# =============================================================================
# Másold át .env néven és töltsd ki!
# FONTOS: A .env fájl SOHA ne kerüljön git-be!
# =============================================================================

# =============================================================================
# BINANCE API
# =============================================================================
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Testnet mód (true = testnet, false = VALÓS PÉNZ!)
BINANCE_TESTNET=true

# =============================================================================
# MONGODB (KÖTELEZŐ live trading-hez!)
# =============================================================================
# MongoDB engedélyezése
MONGODB_ENABLED=true

# MongoDB connection string (KÖTELEZŐ!)
# Formátum: mongodb://user:password@host:27017/database?authSource=admin
# FONTOS: Speciális karakterek URL encode-olva (pl. + → %2B)
MONGODB_URI=mongodb://user:password@host:27017/nautilus?authSource=admin

# =============================================================================
# STRATÉGIA
# =============================================================================
# Stratégia azonosító (egyedi név)
STRATEGY_ID=bounce_scalper_live_001

# External config file használata (ha true, a /app/config/strategy.json-t olvassa)
USE_EXTERNAL_CONFIG=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# DOCKER VOLUMES (host útvonalak)
# =============================================================================
# Config könyvtár a host gépen (ahol a strategy.json van)
# HOST_CONFIG_DIR=/home/user/trading/config

# Logs könyvtár a host gépen
# HOST_LOGS_DIR=/home/user/trading/logs
