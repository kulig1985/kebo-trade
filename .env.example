# ============================================================================
# Kebo Trade - Környezeti Változók
# ============================================================================
#
# HASZNÁLAT:
#   1. Másold .env néven: cp .env.example .env
#   2. Töltsd ki a saját értékeiddel
#   3. Betöltés terminálban: source .env
#   4. Futtatás: python run/run_live.py
#
# TÖBB STRATÉGIA:
#   Minden stratégiához külön .env fájl kell!
#   - bounce-001.env
#   - bounce-002.env
#   Betöltés: source bounce-001.env && python run/run_live.py
#
# ============================================================================

# ============================================================================
# MONGODB (KÖTELEZŐ)
# ============================================================================

# Connection string
# Formátum: mongodb://user:password@host:port/database?authSource=admin
# Speciális karakterek URL encode: + → %2B, @ → %40, / → %2F
export MONGODB_URI="mongodb://user:password@host:27017/nautilus?authSource=admin"

# MongoDB engedélyezése
# true = bekapcsolva (live trading - KÖTELEZŐ)
# false = kikapcsolva (backtest - opcionális)
export MONGODB_ENABLED="true"

# ============================================================================
# STRATÉGIA (KÖTELEZŐ)
# ============================================================================

# Stratégia azonosító - EGYEDI KELL LEGYEN!
# Ha több stratégiát futtatsz, mindegyiknek MÁS ID kell!
# Példák: bounce_scalper_001, btc_scalper_live, eth_strategy_test
export STRATEGY_ID="bounce_scalper_live_001"

# ============================================================================
# BINANCE API (KÖTELEZŐ live tradinghez)
# ============================================================================

# API kulcsok létrehozása: https://www.binance.com/en/my/settings/api-management
export BINANCE_API_KEY="your_api_key_here"
export BINANCE_API_SECRET="your_api_secret_here"

# Testnet mód
# true = TESTNET (teszt pénz, biztonságos)
# false = ÉLES (VALÓS PÉNZ!)
export BINANCE_TESTNET="true"

# ============================================================================
# WEBHOOK (OPCIONÁLIS)
# ============================================================================

# Backend notification URL - ha üres, nem küld webhook-ot
# Példa: http://localhost:3000/api/trading/webhook
export WEBHOOK_URL=""

# Webhook secret - PONTOSAN ugyanaz kell legyen mint a backend-en!
# A backend ezzel ellenőrzi, hogy a request valóban a robottól jön
export WEBHOOK_SECRET=""

# ============================================================================
# LOGGING (OPCIONÁLIS)
# ============================================================================

# Log szint: DEBUG, INFO, WARNING, ERROR
export LOG_LEVEL="INFO"
