# Backtest konfiguráció
# Használat: source env-examples/backtest.env.example && python run/run_backtest.py

# MongoDB - backtest-nél opcionális
export MONGODB_URI="mongodb://user:password@host:27017/nautilus?authSource=admin"
export MONGODB_ENABLED="false"  # Backtest-nél általában kikapcsolva

export STRATEGY_ID="bounce_scalper_backtest"
export LOG_LEVEL="INFO"

