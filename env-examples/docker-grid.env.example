# Grid Strategy - Docker Environment Variables
# =============================================
# Használat: docker run --env-file env-examples/docker-grid.env.example kebo-trade
# FONTOS: Docker env fájlban NINCS "export"!
#
# LEALLITAS:
#   docker-compose down     (ajánlott - graceful shutdown, törli az ordereket)
#   docker stop <container> (graceful shutdown - 30 sec timeout)
#   Ctrl+C                  (graceful shutdown)
#   NE HASZNÁLD: docker kill (azonnal leáll, orderek BENT MARADNAK!)

MONGODB_URI=mongodb://user:password@host:27017/nautilus?authSource=admin
MONGODB_ENABLED=true
STRATEGY_ID=grid_strategy_futures_001
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# Binance Environment: TESTNET, DEMO, vagy LIVE
# TESTNET = teszt hálózat (külön API kulcs kell: testnet.binancefuture.com)
# DEMO    = demo mód (demo-api.binance.com)
# LIVE    = éles kereskedés (VALÓS PÉNZ!)
BINANCE_ENV=TESTNET
LOG_LEVEL=INFO

# Trading mode: futures (Grid Strategy CSAK futures-en működik!)
TRADING_MODE=futures

# Strategy type: grid
STRATEGY_TYPE=grid

# Trading pár
SYMBOL=BTCUSDC

# Webhook (opcionális)
WEBHOOK_URL=
WEBHOOK_SECRET=
