# Grid Strategy - Environment Variables
# =====================================
# Használat: source grid.env && python run/run_live_grid.py

# MongoDB (KÖTELEZŐ)
export MONGODB_URI="mongodb://user:password@host:27017/nautilus?authSource=admin"
export MONGODB_ENABLED="true"

# Stratégia azonosító
export STRATEGY_ID="grid_strategy_futures_001"

# Binance API (KÖTELEZŐ)
export BINANCE_API_KEY="your_api_key"
export BINANCE_API_SECRET="your_api_secret"

# Binance Environment: TESTNET, DEMO, vagy LIVE
# TESTNET = teszt hálózat (külön API kulcs kell: testnet.binancefuture.com)
# DEMO    = demo mód (demo-api.binance.com)
# LIVE    = éles kereskedés (VALÓS PÉNZ!)
export BINANCE_ENV="TESTNET"

# Trading pár
export SYMBOL="BTCUSDC"

# Log level
export LOG_LEVEL="INFO"

# Webhook (opcionális)
export WEBHOOK_URL=""
export WEBHOOK_SECRET=""
