# Docker env fájl - NINCS "export"!
# Használat: docker run --env-file env-examples/docker.env.example kebo-trade:latest

MONGODB_URI=mongodb://user:password@host:27017/nautilus?authSource=admin
MONGODB_ENABLED=true
STRATEGY_ID=bounce_scalper_live_001
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# Binance Environment: TESTNET, DEMO, vagy LIVE
# TESTNET = teszt hálózat (külön API kulcs kell: testnet.binancefuture.com)
# DEMO    = demo mód (demo-api.binance.com)
# LIVE    = éles kereskedés (VALÓS PÉNZ!)
BINANCE_ENV=TESTNET
WEBHOOK_URL=
WEBHOOK_SECRET=
LOG_LEVEL=INFO

# Trading mode: spot, futures, vagy grid
# spot    = Bounce Scalper - Binance SPOT (default)
# futures = Bounce Scalper - Binance Futures USDC Margin
# grid    = Grid Strategy - Binance Futures USDC Margin
TRADING_MODE=spot

# Grid Strategy-hez: SYMBOL beállítása
# (Bounce Scalper-nél a symbols a MongoDB configból jön)
# SYMBOL=BTCUSDC
